# Get this from @BotFather
BOT_TOKEN=

# Your numeric Telegram ID — get it from @userinfobot
OWNER_ID=

# Comma-separated list of extra admin Telegram IDs (optional)
BOT_ADMINS=

BOT_NAME=My Bot

# /start menu buttons
SUPPORT_GROUP_URL=https://t.me/yourgroup
SUPPORT_CHANNEL_URL=https://t.me/yourchannel
DEVELOPER_URL=https://t.me/yourusername
ADD_TO_GROUP_URL=https://t.me/yourbot?startgroup=true

# Optional — only needed for /youtube, /tiktok, /spotify, etc.
MEDIA_API_BASE_URL=
MEDIA_API_KEY=
NEWS_API_KEY=

LOG_LEVEL=info
